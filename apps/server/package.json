    "playwright-core": "1.60.0",
    "proper-lockfile": "4.1.2",
    "stream-chain": "^4.2.5",
    "stream-json": "3.6.0",
    "ws": "8.21.3",
    "yaml": "catalog:",
    "yauzl": "^3.4.0"
