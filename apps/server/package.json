    "@ff-labs/fff-node": "0.11.0",
    "@hpke/chacha20poly1305": "1.8.0",
    "@hpke/core": "1.9.0",
    "@muse-code/sdk": "1.4.6",
    "@napi-rs/keyring": "^1.3.0",
    "@noble/curves": "2.2.0",
    "@opencode-ai/sdk": "^1.3.15",
    "@supacode/provider-acp": "workspace:*",
    "@supacode/provider-acp-registry": "workspace:*",
    "@supacode/provider-core": "workspace:*",
    "@supacode/provider-cursor": "workspace:*",
    "@supacode/provider-grok": "workspace:*",
    "@supacode/provider-muse": "workspace:*",
    "@supacode/provider-opencode": "workspace:*",
    "@supacode/provider-pi": "workspace:*",
    "@supacode/source-control-azure-devops": "workspace:*",
    "@supacode/source-control-bitbucket": "workspace:*",
    "@supacode/source-control-core": "workspace:*",
    "@supacode/source-control-forgejo": "workspace:*",
    "@supacode/source-control-gitcafe": "workspace:*",
    "@supacode/source-control-github": "workspace:*",
    "@supacode/source-control-gitlab": "workspace:*",
    "effect": "catalog:",
    "jose": "catalog:",
